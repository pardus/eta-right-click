Comment[tr]=Uzun basma sağ tık davranışını yapılandırın
Exec=/usr/share/eta/eta-right-click/gui/main.py
Icon=eta-right-click-settings
Categories=Settings;HardwareSettings;
Terminal=false
NoDisplay=false
