#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=ETA Right Click Settings
Name[pt]=Definições do clique com o botão direito
Name[tr]=ETA Sağ Tık Ayarları
Comment=Configure long-press right-click behavior
